{
  "name": "@depxray/mcp",
  "version": "3.0.0",
  "description": "MCP server that gives AI coding agents depxray codebase context, impact analysis, dependency graphs, unused export and unresolved import findings, metrics, and refactor risk.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "depxray-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "node ../../scripts/sync-versions.mjs && npm run build"
  },
  "dependencies": {
    "@depxray/core": "3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dependency-graph",
    "dependency-analysis",
    "static-analysis",
    "codebase-context",
    "codebase-intelligence",
    "imports",
    "refactoring",
    "impact-analysis",
    "blast-radius",
    "claude",
    "cursor",
    "codex",
    "orphan-files",
    "circular-dependencies",
    "monorepo",
    "ai-agent",
    "coding-agent",
    "agentic-ai",
    "llm",
    "typescript",
    "javascript"
  ],
  "author": "Pannawish Kriengyakul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pannawish/depxray.git"
  }
}
