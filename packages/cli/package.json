{
  "name": "depxray",
  "version": "3.1.0",
  "description": "Interactive codebase intelligence CLI for JavaScript and TypeScript with browser dependency graphs, health dashboard, impact analysis, safe cleanup, CI checks, SARIF, reports, and AI-agent context.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "depxray": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && node ./scripts/build-cli.mjs && node ./scripts/bundle-web-ui.mjs && node ./scripts/strip-dist-maps.mjs",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "node ./scripts/build-cli.mjs",
    "bundle:web-ui": "node ./scripts/bundle-web-ui.mjs",
    "strip:maps": "node ./scripts/strip-dist-maps.mjs",
    "dev": "tsc --watch",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "node ../../scripts/sync-versions.mjs && npm run build"
  },
  "devDependencies": {
    "@depxray/core": "3.1.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "commander": "^12.1.0",
    "esbuild": "^0.25.12",
    "execa": "^8.0.1",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "dependency-graph",
    "dependency-analysis",
    "static-analysis",
    "javascript",
    "typescript",
    "imports",
    "codebase",
    "codebase-explorer",
    "visualization",
    "graph",
    "browser-ui",
    "architecture-rules",
    "graph-diff",
    "health-score",
    "health-dashboard",
    "cleanup",
    "dependency-chain",
    "github-pr",
    "pr-review",
    "impact-analysis",
    "blast-radius",
    "monorepo",
    "mcp",
    "reports",
    "orphan-files",
    "circular-dependencies",
    "codebase-context",
    "ai-agent",
    "ai-coding",
    "coding-agent",
    "agentic-ai",
    "llm",
    "architecture",
    "cli"
  ],
  "author": "Pannawish Kriengyakul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pannawish/depxray.git"
  },
  "homepage": "https://github.com/Pannawish/depxray#readme",
  "bugs": {
    "url": "https://github.com/Pannawish/depxray/issues"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "ws": "^8.21.0"
  }
}
