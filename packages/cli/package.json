{
  "name": "@rdg/cli",
  "version": "0.1.0",
  "description": "CLI tool for React Dependency Graph — scan React projects from the terminal or AI agents.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "react-dependency-graph": "./dist/index.js",
    "rdg": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && node ./scripts/build-cli.mjs && node ./scripts/bundle-web-ui.mjs && node ./scripts/strip-dist-maps.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "node ./scripts/build-cli.mjs",
    "bundle:web-ui": "node ./scripts/bundle-web-ui.mjs",
    "strip:maps": "node ./scripts/strip-dist-maps.mjs",
    "dev": "tsc --watch",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@rdg/core": "0.1.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.5",
    "execa": "^8.0.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "react",
    "dependency-graph",
    "cli",
    "static-analysis"
  ],
  "license": "MIT"
}
