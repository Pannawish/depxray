{
  "name": "depxray",
  "version": "1.1.0",
  "description": "Browser-first CLI for exploring JavaScript and TypeScript project structure and dependency graphs, with JSON and static HTML export.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "depxray": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && node ./scripts/build-cli.mjs && node ./scripts/bundle-web-ui.mjs && node ./scripts/strip-dist-maps.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "node ./scripts/build-cli.mjs",
    "bundle:web-ui": "node ./scripts/bundle-web-ui.mjs",
    "strip:maps": "node ./scripts/strip-dist-maps.mjs",
    "dev": "tsc --watch",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "node ../../scripts/sync-versions.mjs && npm run build"
  },
  "devDependencies": {
    "@depxray/core": "1.1.0",
    "@types/node": "^20.0.0",
    "commander": "^12.1.0",
    "esbuild": "^0.21.5",
    "execa": "^8.0.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "dependency-graph",
    "dependency-analysis",
    "static-analysis",
    "javascript",
    "typescript",
    "imports",
    "codebase",
    "visualization",
    "architecture",
    "cli"
  ],
  "author": "Pannawish Kriengyakul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pannawish/depxray"
  },
  "homepage": "https://github.com/Pannawish/depxray#readme",
  "bugs": {
    "url": "https://github.com/Pannawish/depxray/issues"
  }
}
