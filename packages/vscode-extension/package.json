{
  "name": "react-dependency-graph",
  "displayName": "React Dependency Graph",
  "description": "Scan React projects, visualize import dependencies as an interactive graph, detect circular dependencies, and export graph data for AI coding agents.",
  "version": "0.3.0",
  "publisher": "rdg",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "react",
    "dependency",
    "graph",
    "imports",
    "circular",
    "typescript"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rdg.scan",
        "title": "Scan Dependencies",
        "category": "React Dependency Graph",
        "icon": "$(search)"
      },
      {
        "command": "rdg.refresh",
        "title": "Refresh",
        "category": "React Dependency Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "rdg.showGraph",
        "title": "Show Dependency Graph",
        "category": "React Dependency Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "rdg.exportJson",
        "title": "Export Graph as JSON",
        "category": "React Dependency Graph",
        "icon": "$(export)"
      },
      {
        "command": "rdg.openFile",
        "title": "Open File",
        "category": "React Dependency Graph"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rdg-explorer",
          "title": "React Dependencies",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "rdg-explorer": [
        {
          "id": "rdg.dependencyTree",
          "name": "Dependency Tree",
          "contextualTitle": "React Dependency Graph"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rdg.refresh",
          "when": "view == rdg.dependencyTree",
          "group": "navigation@1"
        },
        {
          "command": "rdg.showGraph",
          "when": "view == rdg.dependencyTree",
          "group": "navigation@2"
        },
        {
          "command": "rdg.exportJson",
          "when": "view == rdg.dependencyTree",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rdg.scan",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "rdg.showGraph",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "workspaceFolderCount > 0"
      }
    ]
  },
  "scripts": {
    "prebuild": "npm run build --prefix webview-ui",
    "build": "tsc",
    "dev": "tsc --watch",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist webview-ui/dist"
  },
  "dependencies": {
    "@rdg/core": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  },
  "license": "MIT"
}
