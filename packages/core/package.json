{
  "name": "@depxray/core",
  "version": "0.3.5",
  "description": "Platform-agnostic scanner for JavaScript and TypeScript project structure and dependency graphs, including import analysis and circular detection.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "dependency-graph",
    "dependency-analysis",
    "static-analysis",
    "javascript",
    "typescript",
    "imports",
    "codebase",
    "architecture"
  ],
  "license": "MIT"
}
