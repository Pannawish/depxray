{
  "name": "@depxray/core",
  "version": "3.1.0",
  "description": "Static analysis engine for JavaScript and TypeScript dependency graphs, health scoring, dependency-chain explanations, unused exports, unresolved imports, impact analysis, architecture rules, and AI-agent tooling.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph-contract": {
      "types": "./dist/graphContract.d.ts",
      "default": "./dist/graphContract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "dependency-graph",
    "dependency-analysis",
    "static-analysis",
    "javascript",
    "typescript",
    "imports",
    "codebase",
    "codebase-explorer",
    "architecture",
    "architecture-rules",
    "graph-diff",
    "health-score",
    "dependency-chain",
    "cleanup",
    "github-pr",
    "pr-review",
    "impact-analysis",
    "blast-radius",
    "monorepo",
    "plugins",
    "metrics",
    "orphan-files",
    "circular-dependencies",
    "mcp",
    "ai-agent",
    "coding-agent",
    "agentic-ai",
    "llm"
  ],
  "author": "Pannawish Kriengyakul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pannawish/depxray.git"
  },
  "homepage": "https://github.com/Pannawish/depxray#readme",
  "bugs": {
    "url": "https://github.com/Pannawish/depxray/issues"
  },
  "license": "MIT"
}
